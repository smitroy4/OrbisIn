# Copy to .env (same folder) and fill in real values. .env is git-ignored.
# Neon S3-compatible storage credentials (do NOT commit)
AWS_ENDPOINT_URL_S3=https://br-small-waterfall-b37z6cs5.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
# Bucket must already exist in Neon storage (create via Neon console)
STORAGE_BUCKET=orbisin-uploads
# Optional: set if bucket/CDN is publicly readable; else file URLs are presigned
STORAGE_PUBLIC_BASE_URL=
STORAGE_PRESIGN_EXPIRY_MINUTES=15
# Optional allowlist, e.g. image/png,image/jpeg,application/pdf (empty = allow all)
STORAGE_ALLOWED_CONTENT_TYPES=
STORAGE_MAX_FILE_BYTES=10485760
