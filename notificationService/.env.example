KAFKA_BOOTSTRAP_SERVERS=<host:port>
KAFKA_USERNAME=<kafka-username>
KAFKA_PASSWORD=<kafka-password>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

KAFKA_TOPIC_USER=user_topic
KAFKA_TOPIC_POST=post_topic
KAFKA_TOPIC_CONNECTION=connection_topic

MONGODB_URI=<mongodb-connection-string>
MONGODB_DATABASE=orbisin_notifications
KAFKA_TRUSTSTORE_PASSWORD=<truststore-password>
